# Notion API credentials for --sync and --report
# Get your API key from https://www.notion.so/my-integrations
NOTION_API=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Use ONE of the following:
# Option 1: Database ID (if you have a Notion database)
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Option 2: Page ID (creates sub-pages under this parent page)
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API credentials for --report
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_MODEL=gpt-4o
